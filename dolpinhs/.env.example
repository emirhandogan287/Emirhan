# Kopyalayıp .env olarak kaydedin ve doldurun. .env dosyasını asla paylaşmayın / GitHub'a yüklemeyin.
PORT=3000
# Yönetim paneli (/admin) şifresi — uzun ve tahmin edilemez bir şifre seçin
ADMIN_PASSWORD=
# WhatsApp Business Cloud API (Meta). Boş bırakılırsa deneme modunda çalışır, mesaj gönderilmez.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# İsteğe bağlı
# WHATSAPP_API_VERSION=v21.0
# DB_FILE=./data/dolpinhs.db
